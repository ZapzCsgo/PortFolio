---
import Base from "../layouts/Base.astro";
import Contacts from "../components/Contacts.astro";
import { NAME, ROUTES, UI, type Lang } from "../content/site";
import { CASES, HOME, MORE, SKILLS } from "../content/pages";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = HOME[lang];
const t = UI[lang];
const sep = lang === "fr" ? "\u00a0:" : ":";
const card = h.card.map((c) => ({ ...c, href: "href" in c ? c.href : ROUTES[c.route as "incident" | "deploy"][lang] }));
---

<Base lang={lang} route="home" title={h.seoTitle} description={h.description} wide>
  <section aria-labelledby="titre" class="grid gap-10 lg:grid-cols-[1fr_320px] lg:items-start">
    <div>
      <p class="font-semibold text-muted"><span class="text-fg">{NAME}</span>{h.kicker.slice(NAME.length)}</p>
      <h1 id="titre" class="mt-3 max-w-[20ch] text-[2.125rem] font-bold leading-[1.12] sm:text-5xl">{h.headline}</h1>
      <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-[0.9375rem]">
        {
          h.facts.map((f) => (
            <>
              <dt class="font-semibold text-muted">{f.k}</dt>
              <dd>{f.v}</dd>
            </>
          ))
        }
      </dl>
      <p class="mt-5 max-w-[58ch] border-l-2 border-accent pl-4">
        {h.proof}
        <a href={ROUTES.incident[lang]} class="ml-1 font-semibold text-accent underline underline-offset-4 hover:decoration-2">{h.proofLink}</a>
      </p>
      <div class="mt-6">
        <Contacts lang={lang} />
      </div>
    </div>
    <aside class="rounded-xl border border-line bg-card p-5" aria-labelledby="t-preuves">
      <h2 id="t-preuves" class="text-sm font-semibold text-muted">{h.cardTitle}</h2>
      <ul class="mt-3 divide-y divide-line">
        {
          card.map((s) => (
            <li class="py-3 first:pt-0">
              <a href={s.href} class="group flex gap-3">
                <span class="mt-2 size-2 shrink-0 rounded-full bg-ok" aria-hidden="true" />
                <span>
                  <span class="block font-semibold group-hover:underline group-hover:decoration-accent group-hover:underline-offset-4">{s.k}</span>
                  <span class="block text-[0.9375rem] text-muted">{s.v}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-2 border-t border-line pt-3 text-[0.875rem]">{h.toolsProd}</p>
      <p class="mt-1 text-[0.875rem] text-muted">{h.toolsLearning}</p>
    </aside>
  </section>

  <section id="projets" aria-labelledby="t-cas" class="mt-20">
    <h2 id="t-cas" class="text-2xl font-bold sm:text-3xl">{h.casesTitle}</h2>
    <ul class="mt-6 grid gap-4 md:grid-cols-3">
      {
        CASES[lang].map((c) => (
          <li>
            <a href={ROUTES[c.key][lang]} class="lift flex h-full flex-col rounded-xl border border-line bg-card p-5 hover:border-accent">
              <h3 class="text-lg font-bold">{c.title}</h3>
              <p class="mt-3 text-[0.9375rem] text-muted">{c.problem}</p>
              <p class="mt-3 text-[0.9375rem]">{c.result}</p>
              <span class="mt-auto pt-4 text-[0.9375rem] font-semibold text-accent">{t.readCase}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="competences" aria-labelledby="t-comp" class="mt-20">
    <h2 id="t-comp" class="text-2xl font-bold sm:text-3xl">{h.skillsTitle}</h2>
    <div class="mt-6 overflow-hidden rounded-xl border border-line bg-card">
      <table class="w-full border-collapse text-left text-[0.9375rem]">
        <thead class="hidden sm:table-header-group">
          <tr class="border-b border-line text-sm text-muted">
            <th scope="col" class="w-[22%] px-5 py-3 font-semibold">{h.skillsCols.domain}</th>
            <th scope="col" class="px-5 py-3 font-semibold">
              <span class="mr-2 inline-block size-2 rounded-full bg-ok align-middle" aria-hidden="true"></span>{h.skillsCols.prod}
            </th>
            <th scope="col" class="px-5 py-3 font-semibold">
              <span class="mr-2 inline-block size-2 rounded-full border-2 border-accent align-middle" aria-hidden="true"></span>{h.skillsCols.learning}
            </th>
          </tr>
        </thead>
        <tbody>
          {
            SKILLS[lang].map((s) => (
              <tr class="block border-b border-line px-5 py-4 last:border-b-0 sm:table-row sm:p-0">
                <th scope="row" class="block pb-2 font-semibold sm:table-cell sm:px-5 sm:py-4 sm:align-top">{s.domain}</th>
                <td class="block py-1 sm:table-cell sm:px-5 sm:py-4 sm:align-top">
                  <span class="mr-1 font-semibold text-muted sm:hidden">{h.skillsCols.prod}{sep}</span>
                  {s.prod.length ? s.prod.join(", ") : <span class="text-muted">{h.none}</span>}
                </td>
                <td class:list={["py-1 sm:table-cell sm:px-5 sm:py-4 sm:align-top", s.learning.length ? "block" : "hidden"]}>
                  <span class="mr-1 font-semibold text-muted sm:hidden">{h.skillsCols.learning}{sep}</span>
                  {s.learning.length ? s.learning.join(", ") : <span class="text-muted">-</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="t-aussi" class="mt-20">
    <h2 id="t-aussi" class="text-xl font-bold">{h.moreTitle}</h2>
    <ul class="mt-4 grid gap-4 md:grid-cols-2">
      {
        MORE[lang].map((m) => (
          <li>
            <a href={ROUTES[m.key][lang]} class="lift block h-full rounded-xl border border-line bg-card p-5 hover:border-accent">
              <h3 class="font-bold">{m.title}</h3>
              <p class="mt-2 text-[0.9375rem] text-muted">{m.text}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="contact" aria-labelledby="t-contact" class="mt-20 rounded-xl border border-line bg-card p-6 sm:p-8">
    <h2 id="t-contact" class="text-2xl font-bold sm:text-3xl">{h.contactTitle2}</h2>
    <p class="mt-3 max-w-[60ch] text-muted">{h.contactText}</p>
    <div class="mt-5"><Contacts lang={lang} /></div>
  </section>
</Base>
