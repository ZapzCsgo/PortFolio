---
import Base from "../layouts/Base.astro";
import { CV_PDF, EMAIL, GITHUB, LINKEDIN, NAME, SITE_URL, type Lang } from "../content/site";
import { CV } from "../content/cv";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = CV[lang];
const colon = lang === "fr" ? "\u00a0:" : ":";
const h2 = "mt-5 border-b border-line pb-0.5 text-base font-bold text-accent print:mt-3";
const strip = (u: string) => u.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "");
const contacts = [
  { text: c.location },
  { text: EMAIL, href: `mailto:${EMAIL}` },
  { text: strip(SITE_URL), href: SITE_URL },
  { text: strip(LINKEDIN), href: LINKEDIN },
  { text: strip(GITHUB), href: GITHUB },
];
---

<Base lang={lang} route="cv" title={c.seoTitle} description={c.description}>
  <div class="no-print mb-6">
    <a href={CV_PDF[lang]} class="inline-flex min-h-11 items-center rounded-lg border border-accent bg-accent px-4 font-semibold text-white dark:text-black"
      >{c.download}</a
    >
  </div>
  <article class="cv rounded-xl border border-line bg-card p-5 text-[0.9375rem] leading-normal sm:p-8 print:rounded-none print:border-0 print:p-0">
    <header>
      <h1 class="text-3xl font-bold">{NAME}</h1>
      <p class="mt-1 text-lg font-semibold text-accent">{c.heading}</p>
      <p class="font-semibold">{c.sub}</p>
      <p class="mt-1 text-muted">
        {
          contacts.map((x, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> | </span>}
              {x.href ? <a href={x.href}>{x.text}</a> : <span>{x.text}</span>}
            </>
          ))
        }
      </p>
    </header>

    <h2 class={h2}>{c.profileTitle}</h2>
    <p class="mt-1.5">{c.profile}</p>

    <h2 class={h2}>{c.skillsTitle}</h2>
    <ul class="mt-1.5 space-y-0.5">
      {c.skills.map((s) => <li><strong>{s.label}{colon}</strong> {s.text}</li>)}
    </ul>

    <h2 class={h2}>{c.projectsTitle}</h2>
    {
      c.projects.map((p) => (
        <section class="mt-2 break-inside-avoid">
          <h3 class="font-bold">
            {p.title}
            {p.where && <span class="font-normal text-muted"> ({p.where})</span>}
          </h3>
          <ul class="mt-0.5 list-disc space-y-0.5 pl-5 marker:text-accent">
            {p.points.map((x) => <li>{x}</li>)}
          </ul>
        </section>
      ))
    }

    <h2 class={h2}>{c.workTitle}</h2>
    <ul class="mt-1.5 space-y-0.5">
      {
        c.work.map((w) => (
          <li>
            <strong>{w.title}</strong>
            {w.where && <span>, {w.where}</span>}
            {w.when && <span class="text-muted">, {w.when}</span>}
            {w.points.length > 0 && (
              <ul class="list-disc pl-5 marker:text-accent">
                {w.points.map((x) => <li>{x}</li>)}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <h2 class={h2}>{c.eduTitle}</h2>
    <ul class="mt-1.5 space-y-0.5">
      {
        c.edu.map((e) => (
          <li>
            <strong>{e.title}</strong>
            {e.when && <span class="text-muted">, {e.when}</span>}
            {e.points.length > 0 && <span>. {e.points.join(" ")}</span>}
          </li>
        ))
      }
    </ul>

    <h2 class={h2}>{c.certTitle}</h2>
    <p class="mt-1.5">
      {
        c.certs.map((x, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> | </span>}
            {x.href ? <a href={x.href}>{x.text}</a> : <span>{x.text}</span>}
          </>
        ))
      }
    </p>

    <h2 class={h2}>{c.langTitle}</h2>
    <p class="mt-1.5">{c.langs}</p>
  </article>
</Base>

<style is:global>
  @page {
    size: A4;
    margin: 9mm 12mm;
  }
  @media print {
    :root,
    :root[data-theme="dark"],
    :root[data-theme="light"] {
      --bg: #ffffff;
      --card: #ffffff;
      --line: #d6d3d1;
      --fg: #1c1917;
      --muted: #44403c;
      --accent: #c2410c;
      --accent-soft: #fff1e6;
      color-scheme: light;
      font-size: 11.6px;
    }
    body {
      background: #fff;
    }
    main {
      max-width: none !important;
      padding: 0 !important;
    }
    .cv a {
      text-decoration: none;
    }
  }
  .cv,
  .cv * {
    font-feature-settings: "calt" 0, "case" 0, "liga" 0;
    font-variant-ligatures: none;
  }
</style>
