---
import Base from "../layouts/Base.astro";
import { ROUTES, UI, type Lang } from "../content/site";
import { INCIDENT } from "../content/incident";
import { rich } from "../lib/build";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = INCIDENT[lang];
const t = UI[lang];
const h2 = "mt-12 text-2xl font-bold";
const list = "mt-4 list-disc space-y-2 pl-5 marker:text-accent";
---

<Base lang={lang} route="incident" title={d.seoTitle} description={d.description} ogType="article">
  <a href={ROUTES.home[lang]} class="text-[0.9375rem] text-muted hover:text-fg">{t.back}</a>
  <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{d.title}</h1>
  <p class="mt-4 text-lg">{d.lead}</p>

  <dl class="mt-8 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
    {
      d.facts.map((f) => (
        <div class="bg-card p-4">
          <dt class="text-sm font-semibold text-muted">{f.label}</dt>
          <dd class="mt-1" set:html={rich(f.value)} />
        </div>
      ))
    }
  </dl>

  <h2 class={h2}>{d.summaryTitle}</h2>
  {d.summary.map((p) => <p class="mt-4" set:html={rich(p)} />)}

  <h2 class={h2}>{d.timelineTitle}</h2>
  <p class="mt-2 text-[0.9375rem] text-muted">{d.timelineNote}</p>
  <ol class="mt-5 border-l-2 border-line">
    {
      d.timeline.map((e) => (
        <li class="relative pb-6 pl-6 last:pb-0">
          <span class="absolute -left-[7px] top-2 size-3 rounded-full border-2 border-accent bg-bg" aria-hidden="true" />
          <span class="block font-bold tabular-nums text-accent">{e.time}</span>
          <span class="mt-1 block" set:html={rich(e.text)} />
        </li>
      ))
    }
  </ol>

  <h2 class={h2}>{d.causeTitle}</h2>
  {d.cause.map((p) => <p class="mt-4" set:html={rich(p)} />)}

  <h2 class={h2}>{d.impactTitle}</h2>
  <ul class={list}>{d.impact.map((p) => <li set:html={rich(p)} />)}</ul>

  <h2 class={h2}>{d.helpedTitle}</h2>
  <ul class={list}>{d.helped.map((p) => <li set:html={rich(p)} />)}</ul>

  <h2 class={h2}>{d.fixTitle}</h2>
  <ol class="mt-4 space-y-3">
    {
      d.fix.map((p, i) => (
        <li class="flex gap-3 rounded-xl border border-line bg-card p-4">
          <span class="grid size-7 shrink-0 place-items-center rounded-full bg-accent-soft text-sm font-bold text-accent" aria-hidden="true">
            {i + 1}
          </span>
          <span set:html={rich(p)} />
        </li>
      ))
    }
  </ol>

  <h2 class={h2}>{d.learnedTitle}</h2>
  <ul class={list}>{d.learned.map((p) => <li set:html={rich(p)} />)}</ul>

  <p class="mt-12">
    <a class="prose-link font-semibold" href={ROUTES.gts[lang]}>{lang === "fr" ? "Voir comment GaijinToSensei est mis en production" : "See how GaijinToSensei ships to production"}</a>
  </p>
</Base>
