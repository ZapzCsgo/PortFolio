{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/((?!_astro/|.*\\.[a-zA-Z0-9]+$).*)",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/about", "destination": "/a-propos/", "permanent": true },
    { "source": "/certifications", "destination": "/a-propos/", "permanent": true },
    { "source": "/ctf-blog", "destination": "/", "permanent": true },
    { "source": "/ctf-blog/:path*", "destination": "/", "permanent": true },
    { "source": "/projets/incident-base-de-donnees", "destination": "/projets/agents-ia/", "statusCode": 301 },
    { "source": "/projets/incident-base-de-donnees/", "destination": "/projets/agents-ia/", "statusCode": 301 },
    { "source": "/en/projects/database-incident", "destination": "/en/projects/ai-agents/", "statusCode": 301 },
    { "source": "/en/projects/database-incident/", "destination": "/en/projects/ai-agents/", "statusCode": 301 }
  ]
}
