// Hébergement de zapz.work : Worker Cloudflare + assets statiques (dist/ construit par `npm run build`).
// Déploiement : `npm run build && npx wrangler deploy` (voir README, section Déploiement).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zapz-portfolio",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "zapz.work", "custom_domain": true },
    { "pattern": "www.zapz.work", "custom_domain": true }
  ],
  "observability": { "enabled": false }
}
